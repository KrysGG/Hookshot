#version 450
// the frame to the window's size (the Insert menu's Upscaling, Sharpness): Catmull-Rom or Lanczos 2, or the linear filter, then
// a contrast-adaptive sharpen in the manner of AMD FidelityFX RCAS that cannot go past the light around the pixel, so it adds no halos,
// no clipping and no flashes
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
// (and ultrawide's menus: while a menu shows, the picture's sides outside the middle 16:9, x0..x1 of its width, a blurred mirror of the
// middle (side 1) or black (side 2), with a short soft edge; vk_framegen.cpp wide_sides)
// (and the Cheats/Mods tab's screen filter over it all: fx 1 CRT, 2 scanlines, 3 film; strength 0..1; time, seconds, for the grain)
layout(push_constant) uniform P { int mode; float sharp; float x0; float x1; int side; int fx; float strength; float time; } pc;
const float PI = 3.14159265;
float lanczos2(float x) {
    x = abs(x);
    if (x < 1e-4) return 1.0;
    if (x >= 2.0) return 0.0;
    const float p = PI * x;
    return 2.0 * sin(p) * sin(p * 0.5) / (p * p);
}
float catmull(float x) {
    x = abs(x);
    if (x < 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}
vec3 filtered(vec2 uv) {
    if (pc.mode == 0) return textureLod(src, uv, 0.0).rgb;
    const vec2 size = vec2(textureSize(src, 0));
    const vec2 p = uv * size - 0.5;
    const ivec2 b = ivec2(floor(p));
    const vec2 f = p - vec2(b);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = -1; y <= 2; y++)
        for (int x = -1; x <= 2; x++) {
            const vec2 d = vec2(x, y) - f;
            const float w = pc.mode == 2 ? lanczos2(d.x) * lanczos2(d.y) : catmull(d.x) * catmull(d.y);
            sum += w * texelFetch(src, clamp(b + ivec2(x, y), ivec2(0), ivec2(size) - 1), 0).rgb;
            weight += w;
        }
    return sum / weight;
}
// The Sharpness slider (pc.sharp 0 to 1) is RCAS's strength: 0 the picture as filtered, 1 its strongest lobe.
const float kMaxLobe = 0.25 - 1.0 / 16.0;
vec3 sharpen(vec3 c, vec3 n, vec3 s, vec3 w, vec3 e, float amount) {
    // RCAS: the four neighbours weighted by a negative lobe, the largest that keeps the result inside 0..1 for this
    // neighbourhood (smaller where the light is near black or white), then normalized. Two differences from RCAS's own
    // maths: the room to black divides by 4 x the lightest of the pixel and its neighbours (RCAS: of the neighbours
    // alone), never more room than RCAS gives, so only more careful; and like RCAS the room is the smallest of the three
    // channels, so a saturated colour (a channel near 0 or 1, not only near black or white) is sharpened little
    const vec3 lo4 = min(min(n, s), min(w, e)), hi4 = max(max(n, s), max(w, e));
    const vec3 lo = min(lo4, c), hi = max(hi4, c);
    const vec3 to_black = lo / max(4.0 * hi, vec3(1.0 / 1024.0));
    const vec3 to_white = (1.0 - hi) / max(4.0 - 4.0 * lo4, vec3(1.0 / 1024.0));
    const vec3 room = min(to_black, to_white);
    const float lobe = -clamp(min(min(room.r, room.g), room.b), 0.0, kMaxLobe) * clamp(amount, 0.0, 1.0);
    const vec3 sharp = (c + lobe * (n + s + w + e)) / (1.0 + 4.0 * lobe);
    // (and no further than the lightest and darkest pixel around it: an edge gets steeper, no halo beside it)
    return clamp(sharp, lo, hi);
}
// beside a menu: the middle 16:9 mirrored outwards at its edge and blurred wide (11 x 11 taps 2.5% of the height apart), dimmed a
// little, so the sides carry the middle's colours (the item wheel's scene, a menu's frame) instead of what the game left there
vec3 side_fill(vec2 uv, ivec2 d) {
    const float x = uv.x < pc.x0 ? 2.0 * pc.x0 - uv.x : 2.0 * pc.x1 - uv.x;
    const vec2 at = vec2(clamp(x, pc.x0, pc.x1), uv.y);
    const vec2 step = vec2(0.025 * float(d.y) / float(d.x), 0.025);
    vec3 sum = vec3(0.0);
    for (int y = -5; y <= 5; y++)
        for (int i = -5; i <= 5; i++)
            sum += textureLod(src, vec2(clamp(at.x + float(i) * step.x, pc.x0, pc.x1), clamp(at.y + float(y) * step.y, 0.0, 1.0)), 0.0).rgb;
    return sum / 121.0 * 0.6;
}
float hash12(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    vec2 uv = (vec2(g) + 0.5) / vec2(d);
    const float k = clamp(pc.strength, 0.0, 1.0);
    if (pc.fx == 1) {   // CRT: the glass's curve, the picture pulled in towards the corners (outside it: the tube's black frame)
        vec2 q = uv * 2.0 - 1.0;
        q *= 1.0 + 0.06 * k * (q.yx * q.yx);
        uv = q * 0.5 + 0.5;
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
            imageStore(dst, g, vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }
    }
    vec3 c = filtered(uv);
    if (pc.sharp > 0.0) {
        // The neighbours one picture pixel away (one window pixel when the window is the smaller). They were one window
        // pixel away, a fraction of a picture pixel when the window is larger (0.53 for 2048 x 1152 on a 3840 x 2160
        // screen): what the slider did then hung on the window's size, not on the picture.
        const vec2 e = max(1.0 / vec2(textureSize(src, 0)), 1.0 / vec2(d));
        const vec3 n = textureLod(src, uv + vec2(0.0, -e.y), 0.0).rgb, s = textureLod(src, uv + vec2(0.0, e.y), 0.0).rgb;
        const vec3 w = textureLod(src, uv + vec2(-e.x, 0.0), 0.0).rgb, r = textureLod(src, uv + vec2(e.x, 0.0), 0.0).rgb;
        c = sharpen(c, n, s, w, r, pc.sharp);
    }
    if (pc.side != 0 && pc.x1 > pc.x0) {
        const float feather = 0.006;
        const float outside = max(1.0 - smoothstep(pc.x0 - feather, pc.x0, uv.x), smoothstep(pc.x1, pc.x1 + feather, uv.x));
        if (outside > 0.0) c = mix(c, pc.side == 2 ? vec3(0.0) : side_fill(uv, d), outside);
    }
    if (pc.fx == 1 || pc.fx == 2) {   // scanlines: a dark gap every third line of the window
        const float line = 0.5 + 0.5 * cos(6.2831853 * (float(g.y) + 0.5) / 3.0);
        c *= mix(1.0, 0.55 + 0.45 * line, k);
    }
    if (pc.fx == 1) {   // an aperture grille (R, G, B columns), the vignette, and a lift for the light they take
        const int col = g.x % 3;
        const vec3 mask = col == 0 ? vec3(1.0, 0.72, 0.72) : col == 1 ? vec3(0.72, 1.0, 0.72) : vec3(0.72, 0.72, 1.0);
        c *= mix(vec3(1.0), mask, 0.8 * k);
        const vec2 v = uv * (1.0 - uv);
        c *= mix(1.0, pow(clamp(v.x * v.y * 15.0, 0.0, 1.0), 0.25), k);
        c *= 1.0 + 0.35 * k;
    } else if (pc.fx == 2) {
        c *= 1.0 + 0.2 * k;
    } else if (pc.fx == 3) {   // film: warmer, shadows lifted a little, grain that moves, the vignette
        const vec3 warm = vec3(1.06, 1.0, 0.9) * (c * 0.94 + 0.03);
        const float grain = hash12(vec2(g) + fract(pc.time) * 4096.0) - 0.5;
        const vec2 v = uv * (1.0 - uv);
        c = mix(c, warm + grain * 0.06, k) * mix(1.0, pow(clamp(v.x * v.y * 16.0, 0.0, 1.0), 0.3), k);
    }
    imageStore(dst, g, vec4(clamp(c, 0.0, 1.0), 1.0));
}
